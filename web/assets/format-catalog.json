{
  "version": 1,
  "samples": [
    {
      "id": "postcard",
      "file": "assets/import-samples/postcard.ora",
      "cover": "assets/import-samples/postcard-goal.png",
      "title": "海岸明信片",
      "subtitle": "换上 JPEG 海岸画面，再叠加两种透明素材。",
      "formats": [
        "JPEG",
        "WebP",
        "PNG"
      ],
      "width": 480,
      "height": 288,
      "layerCount": 2,
      "author": "MoonOpenRaster",
      "source": "https://github.com/gywcs101/MoonOpenRaster/blob/main/LICENSE",
      "sourceTitle": "原创格式练习",
      "note": "用于展示图片导入与图层编辑。",
      "license": "MIT",
      "practice": {
        "file": "assets/import-samples/postcard.ora",
        "start": "assets/import-samples/postcard-start.png",
        "goal": "assets/import-samples/postcard-goal.png",
        "goalFile": "assets/import-samples/postcard-goal.ora",
        "steps": [
          {
            "title": "替换照片",
            "text": "用 JPEG 替换照片窗口，保留原位置。",
            "checks": [
              {
                "name": "照片窗口",
                "type": "image",
                "insert": false,
                "asset": "assets/import-samples/tide.jpg",
                "thumbnail": "",
                "width": 296,
                "height": 171,
                "bitDepth": 8
              }
            ],
            "suggestion": "替换照片"
          },
          {
            "title": "加上透明邮戳",
            "text": "导入透明 WebP，观察邮戳边缘与底图的叠加。",
            "checks": [
              {
                "name": "stamp",
                "type": "image",
                "insert": true,
                "asset": "assets/import-samples/stamp.webp",
                "thumbnail": "",
                "width": 95,
                "height": 107,
                "bitDepth": 8
              }
            ],
            "suggestion": "加上透明邮戳"
          },
          {
            "title": "安排邮戳位置",
            "text": "把邮戳移到 X=345、Y=85，再将不透明度调为 85%。",
            "checks": [
              {
                "name": "stamp",
                "type": "properties",
                "expected": {
                  "x": 345,
                  "y": 85,
                  "opacity": 0.85
                }
              }
            ],
            "suggestion": "安排邮戳位置"
          },
          {
            "title": "加入波形标记",
            "text": "导入透明 PNG 标记，观察底图如何透过空白处显示。",
            "checks": [
              {
                "name": "tide-mark",
                "type": "image",
                "insert": true,
                "asset": "assets/import-samples/tide-mark.png",
                "thumbnail": "",
                "width": 48,
                "height": 36,
                "bitDepth": 8
              }
            ],
            "suggestion": "加入波形标记"
          },
          {
            "title": "对齐标记",
            "text": "把波形移到邮戳下方，参考位置 X=366、Y=173。",
            "checks": [
              {
                "name": "tide-mark",
                "type": "properties",
                "expected": {
                  "x": 366,
                  "y": 173
                }
              }
            ],
            "suggestion": "对齐标记"
          },
          {
            "title": "导出成图",
            "text": "导出 PNG，或保存 ORA 后重开检查图层。",
            "type": "export"
          }
        ]
      }
    },
    {
      "id": "atlas",
      "file": "assets/import-samples/atlas.ora",
      "cover": "assets/import-samples/atlas-goal.png",
      "title": "地形测绘图",
      "subtitle": "保留 16 位等高渐变，配上独立的图例。",
      "formats": [
        "16 位 TIFF",
        "BMP"
      ],
      "width": 480,
      "height": 288,
      "layerCount": 2,
      "author": "MoonOpenRaster",
      "source": "https://github.com/gywcs101/MoonOpenRaster/blob/main/LICENSE",
      "sourceTitle": "原创格式练习",
      "note": "用于展示图片导入与图层编辑。",
      "license": "MIT",
      "practice": {
        "file": "assets/import-samples/atlas.ora",
        "start": "assets/import-samples/atlas-start.png",
        "goal": "assets/import-samples/atlas-goal.png",
        "goalFile": "assets/import-samples/atlas-goal.ora",
        "steps": [
          {
            "title": "换入 16 位地形",
            "text": "用 TIFF 替换高程窗口，检查图层和画布的位深。",
            "checks": [
              {
                "name": "高程窗口",
                "type": "image",
                "insert": false,
                "asset": "assets/import-samples/elevation.tiff",
                "thumbnail": "",
                "width": 351,
                "height": 166,
                "bitDepth": 16
              }
            ],
            "suggestion": "换入 16 位地形"
          },
          {
            "title": "导入图例",
            "text": "添加 BMP 图例，底板与高程层保持独立。",
            "checks": [
              {
                "name": "legend",
                "type": "image",
                "insert": true,
                "asset": "assets/import-samples/legend.bmp",
                "thumbnail": "",
                "width": 62,
                "height": 145,
                "bitDepth": 8
              }
            ],
            "suggestion": "导入图例"
          },
          {
            "title": "靠右对齐",
            "text": "把图例摆到高程图右侧，参考位置 X=389、Y=62。",
            "checks": [
              {
                "name": "legend",
                "type": "properties",
                "expected": {
                  "x": 389,
                  "y": 62
                }
              }
            ],
            "suggestion": "靠右对齐"
          },
          {
            "title": "调整高程层",
            "text": "将高程层的不透明度调为 82%，再导出 16 位画面。",
            "checks": [
              {
                "name": "高程窗口",
                "type": "properties",
                "expected": {
                  "opacity": 0.82
                }
              }
            ],
            "suggestion": "调整高程层"
          },
          {
            "title": "导出成图",
            "text": "导出 PNG，或保存 ORA 后重开检查图层。",
            "type": "export"
          }
        ]
      }
    },
    {
      "id": "signal",
      "file": "assets/import-samples/signal.ora",
      "cover": "assets/import-samples/signal-goal.png",
      "title": "夜间车站",
