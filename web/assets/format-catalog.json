      "formats": [
        "GIF",
        "ICO"
      ],
      "width": 480,
      "height": 288,
      "layerCount": 2,
      "author": "MoonOpenRaster",
      "source": "https://github.com/gywcs101/MoonOpenRaster/blob/main/LICENSE",
      "sourceTitle": "原创格式练习",
      "note": "用于展示图片导入与图层编辑。",
      "license": "MIT",
      "practice": {
        "file": "assets/import-samples/signal.ora",
        "start": "assets/import-samples/signal-start.png",
        "goal": "assets/import-samples/signal-goal.png",
        "goalFile": "assets/import-samples/signal-goal.ora",
        "steps": [
          {
            "title": "换上发车灯牌",
            "text": "用 GIF 替换灯牌，工作台会导入动画第一帧。",
