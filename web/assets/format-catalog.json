              {
                "name": "灯牌",
                "type": "image",
                "insert": false,
                "asset": "assets/import-samples/departures.gif",
                "thumbnail": "",
                "width": 65,
                "height": 27,
                "bitDepth": 8
              }
            ],
            "suggestion": "换上发车灯牌"
          },
          {
            "title": "加入车站标志",
            "text": "导入 ICO，使用其中最大的图标。",
            "checks": [
              {
                "name": "station",
                "type": "image",
                "insert": true,
                "asset": "assets/import-samples/station.ico",
                "thumbnail": "",
                "width": 64,
                "height": 64,
                "bitDepth": 8
              }
            ],
            "suggestion": "加入车站标志"
          },
          {
            "title": "移动站标",
            "text": "把站标移动到右下方，参考位置 X=360、Y=151。",
            "checks": [
              {
                "name": "station",
                "type": "properties",
                "expected": {
                  "x": 360,
                  "y": 151
                }
              }
            ],
            "suggestion": "移动站标"
          },
          {
            "title": "切换灯牌显隐",
            "text": "隐藏灯牌，保留它的像素数据以便稍后恢复。",
            "checks": [
              {
                "name": "灯牌",
                "type": "properties",
                "expected": {
                  "visible": false
                }
              }
            ],
            "suggestion": "切换灯牌显隐"
          },
          {
            "title": "导出成图",
            "text": "导出 PNG，或保存 ORA 后重开检查图层。",
            "type": "export"
          }
        ]
      }
    }
  ]
}
